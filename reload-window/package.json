{
  "name": "reload-window-button",
  "displayName": "Reload Window Button",
  "description": "A status bar button (bottom right) that reloads the VS Code window.",
  "version": "1.0.0",
  "publisher": "local",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reloadWindowButton.reload",
        "title": "Reload Window (Button)",
        "icon": "$(refresh)"
      }
    ]
  }
}

